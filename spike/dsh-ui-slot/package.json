{
  "name": "dsh-studio-ui-spike",
  "version": "0.0.0",
  "private": true,
  "description": "Spike：验证第三方 UI 插件能否占位 DSH 浏览器前端的 slot",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
